{
  "compilerOptions": {
    "target": "ES2020",                          // Modern JS features like async/await
    "module": "commonjs",                        // Node module system
    "lib": ["ESNext", "DOM"],                    // Includes browser APIs for Playwright
    "strict": true,                              // Enable strict type checking
    "esModuleInterop": true,                     // Allows default imports from CommonJS
    "forceConsistentCasingInFileNames": true,   // Avoid path casing issues
    "skipLibCheck": true,                        // Skip type checking in node_modules
    "moduleResolution": "node",
    "resolveJsonModule": true,                   // Allow import of JSON (for created-user.json)
    "types": ["node", "playwright", "@playwright/test"], // Include Playwright & Node types
    "outDir": "dist",                            // Optional: compiled JS output
    "rootDir": "qa",                       // Source TS code folder
    "noImplicitAny": true                         // Prevent implicit any types
  },
  "include": [
    "qa/tests/**/*.ts",
    "qa/tests/**/*.json"                         // Include JSON for created-user.json import
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}